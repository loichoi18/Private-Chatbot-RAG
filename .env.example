# ╔══════════════════════════════════════════════════════════╗
# ║          Private RAG Chatbot — Configuration             ║
# ║   Copy this file to .env and fill in your values         ║
# ╚══════════════════════════════════════════════════════════╝

# ── LLM Provider ─────────────────────────────────────────────
# Options: openai | anthropic | ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# ── API Keys (fill in the one you use) ──────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ── Ollama (for local/free LLM) ─────────────────────────────
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3.1

# ── Embedding ────────────────────────────────────────────────
# Options: openai | huggingface | cohere
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# For HuggingFace (free, runs locally):
# EMBEDDING_PROVIDER=huggingface
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIMENSION=384

# ── Vector Store ─────────────────────────────────────────────
# Options: chroma | qdrant
VECTORSTORE_PROVIDER=chroma
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=documents

# For Qdrant:
# VECTORSTORE_PROVIDER=qdrant
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION_NAME=documents

# ── Chunking ─────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ── Retrieval ────────────────────────────────────────────────
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.3
RERANK_ENABLED=false
RERANK_TOP_K=3

# ── API Server ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
